<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>orthomania</AssemblyName>
    <RootNamespace>Orthomania.Patcher</RootNamespace>
    <AssemblyTitle>orthomania</AssemblyTitle>
    <Description>Checks osu!(lazer) and orthomania for updates, then starts osu! with orthomania hooked in.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <!--
    Published for a platform (dotnet publish -r win-x64), the patcher is one file, orthomania.exe: the .NET runtime, osu-framework and
    its native libraries (SDL, BASS, the renderers) are all inside it, so a release is that file alone and needs nothing installed.
    The native libraries are unpacked to a cache folder (%TEMP%\.net\orthomania) on first start. Builds and tests are unchanged.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <!-- A linker file one of osu-framework's packages ships beside its native library: not needed to run, and not bundled. -->
  <Target Name="LeaveOutLinkerFiles" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.lib'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
  </ItemGroup>
  <!--
    The patcher release workflow publishes with -p:OrthomaniaRelease=true (and -p:Version=x.y.z). Only such a build replaces itself with a
    newer published patcher; one built from a clone (launch.bat, dotnet run) only says a newer one is out.
  -->
  <ItemGroup Condition="'$(OrthomaniaRelease)' == 'true'">
    <AssemblyMetadata Include="OrthomaniaRelease" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Orthomania.Patcher.Core\Orthomania.Patcher.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The engine osu!(lazer) runs on, at the version lazer 2026.1026.0 uses, so the window draws the way lazer does. -->
    <PackageReference Include="ppy.osu.Framework" Version="2026.1019.0" />
    <!--
      The framework asks for ImageSharp 3.1.11, as osu!(lazer) does; 3.1.12 is the newest 3.1 (3.2 needs a paid licence key to build).
      Its advisories are about decoding crafted images. The patcher only decodes images from the framework's own resources and lazer's
      installed font pages, never ones from elsewhere, so they are acknowledged here rather than failing the build.
    -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
</Project>
